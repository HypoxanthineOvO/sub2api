[Unit]
Description=VSP Sub2API Selected Node aggregator (%i)
After=network-online.target
Wants=network-online.target
PartOf=vsp-sub2api-%i.target

[Service]
Type=simple
User=heyx
Group=vsp-admin
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/vsp-sub2api/current/ops/selected-node/selected_node_aggregator.py --config /etc/vsp-sub2api/%i/selected-node.json
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=vsp-sub2api-%i.target
