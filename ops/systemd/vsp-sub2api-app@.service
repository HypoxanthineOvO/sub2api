[Unit]
Description=VSP Sub2API application (%i)
Requires=vsp-postgresql@%i.service vsp-redis@%i.service
After=network-online.target vsp-postgresql@%i.service vsp-redis@%i.service
Wants=network-online.target
PartOf=vsp-sub2api-%i.target

[Service]
Type=simple
User=heyx
Group=vsp-admin
WorkingDirectory=/var/lib/vsp-sub2api/%i/app
EnvironmentFile=/etc/vsp-sub2api/%i/app.env
ExecStart=/opt/vsp-sub2api/current/sub2api
Restart=always
RestartSec=5
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vsp-sub2api/%i/app

[Install]
WantedBy=vsp-sub2api-%i.target
