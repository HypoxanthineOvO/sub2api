[Unit]
Description=VSP Sub2API Mihomo production %i
After=network-online.target
Wants=network-online.target
PartOf=vsp-sub2api-production.target

[Service]
Type=simple
User=heyx
Group=vsp-admin
ExecStart=/home/heyx/.local/bin/mihomo -d /var/lib/vsp-sub2api/production/mihomo/%i -f /etc/vsp-sub2api/production/mihomo/%i/config.yaml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/vsp-sub2api/production/mihomo/%i

[Install]
WantedBy=vsp-sub2api-production.target
