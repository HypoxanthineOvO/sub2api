[Unit]
Description=VSP Sub2API native production stack
Requires=vsp-postgresql@production.service
Requires=vsp-redis@production.service
# The only retained proxy is general. Its maintenance must not stop the data plane.
Wants=vsp-mihomo-production@general.service
After=network-online.target

[Install]
WantedBy=multi-user.target
Alias=vsp-sub2api.target
