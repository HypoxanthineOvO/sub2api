[Unit]
Description=VSP Sub2API native production stack
Requires=vsp-postgresql@production.service
Requires=vsp-redis@production.service
Requires=vsp-mihomo-production@slot-a.service vsp-mihomo-production@slot-b.service vsp-mihomo-production@slot-c.service vsp-mihomo-production@slot-d.service vsp-mihomo-production@slot-e.service
Requires=vsp-proxy-allocator@production.service
Requires=vsp-selected-node@production.service
After=network-online.target

[Install]
WantedBy=multi-user.target
Alias=vsp-sub2api.target
