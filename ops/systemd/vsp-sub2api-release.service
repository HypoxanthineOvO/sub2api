[Unit]
Description=VSP Sub2API serialized release transaction
After=network-online.target nginx.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -I /usr/local/libexec/vsp-sub2api-release/release_runner.py
ExecStopPost=/usr/bin/python3 -I /usr/local/libexec/vsp-sub2api-release/release_runner.py --recover
TimeoutStartSec=3600
TimeoutStopSec=3600
KillMode=control-group
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
MemoryMax=256M
CPUQuota=50%
ProtectHome=read-only
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
