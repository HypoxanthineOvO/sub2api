[Unit]
Description=VSP Sub2API proxy allocator (%i)
After=network-online.target
Wants=network-online.target
PartOf=vsp-sub2api-%i.target

[Service]
Type=simple
User=heyx
Group=vsp-admin
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/vsp-sub2api/current/ops/llm-proxy/allocator.py --config /etc/vsp-sub2api/%i/allocator.json --state /var/lib/vsp-sub2api/%i/allocator/state.json --lock /var/lib/vsp-sub2api/%i/allocator/allocator.lock --interval 60
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vsp-sub2api/%i/allocator

[Install]
WantedBy=vsp-sub2api-%i.target
